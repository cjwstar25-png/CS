local function installNamecallHook()
    if not (HAS_HOOKMM and HAS_RAWMT and HAS_GETNC) then return end
    pcall(function()
        local mt = getrawmetatable(game)
        if HAS_SETRO then setreadonly(mt, false) end
        if NC_ORIG == nil then NC_ORIG = mt.__namecall end
        mt.__namecall = nc(function(self, ...)
            local m = getnamecallmethod()
            if _BLOCKED[m] then
                if m == _sc(75,105,99,107) or m == _sc(66,97,110) or m == _sc(68,105,115,99,111,110,110,101,99,116) then
                    return nil
                end
                if m == _sc(84,101,108,101,112,111,114,116) or m == _sc(84,101,108,101,112,111,114,116,65,115,121,110,99)
                   or m == _sc(84,101,108,101,112,111,114,116,84,111,80,108,97,99,101,73,110,115,116,97,110,99,101)
                   or m == _sc(84,101,108,101,112,111,114,116,84,111,80,114,105,118,97,116,101,83,101,114,118,101,114)
                   or m == _sc(84,101,108,101,112,111,114,116,80,97,114,116,121,65,115,121,110,99) then return nil end
            end

            if m == "FireServer" and captureArmed and self and typeof(self) == "Instance"
               and self:IsA("RemoteEvent") then
                local n = self.Name:lower()
                if not isCaptureBlacklisted(n) then
                    local args = {...}
                    local argTypes = {}
                    for i, v in ipairs(args) do
                        argTypes[i] = typeof(v)
                    end
                    capturedAttack = {
                        remote = self, remoteName = self:GetFullName(),
                        args = args, argTypes = argTypes, capturedAt = tick(),
                    }
                    captureArmed = false
                    if _G.__cubicOnCapture then _G.__cubicOnCapture(capturedAttack) end
                end
            end

            if m == "FireServer" and states.SilentAim and getClosestTargetRef then
                local char = LocalPlayer.Character
                if char then
                    local target, dist = getClosestTargetRef()
                    if target and dist < (settingsConfig.KillAuraRange or 100) then
                        local head = target.Character and target.Character:FindFirstChild("Head")
                        if head then
                            local args = {...}
                            local replaced = false
                            for i, v in ipairs(args) do
                                if typeof(v) == "Vector3" then args[i] = head.Position; replaced = true end
                            end
                            if replaced then
                                if registerHit then registerHit(target) end
                                return NC_ORIG(self, table.unpack(args))
                            end
                        end
                    end
                end
            end
            return NC_ORIG(self, ...)
        end)
        if HAS_SETRO then setreadonly(mt, true) end
    end)
end
installNamecallHook()

local function installIndexHooks()
    if not (HAS_HOOKMM and HAS_RAWMT) then return end
    pcall(function()
        local mt = getrawmetatable(game)
        if HAS_SETRO then setreadonly(mt, false) end
        if IDX_ORIG == nil then IDX_ORIG = mt.__index end
        mt.__index = nc(function(self, key)
            if self == game then
                if key == _HG or key == _HP or key == _HPA then
                    return function() return "" end
                end
            end
            if self == LocalPlayer and key == _sc(75,105,99,107) then
                return function() end
            end
            return IDX_ORIG(self, key)
        end)
        if NIDX_ORIG == nil then NIDX_ORIG = mt.__newindex end
        mt.__newindex = nc(function(self, key, value)
            if self == game and (key == _HG or key == _HP) then return end
            return NIDX_ORIG(self, key, value)
        end)
        if HAS_SETRO then setreadonly(mt, true) end
    end)
end
installIndexHooks()

local function silentLogFilter()
    if HAS_HOOKFN then
        pcall(function()
            if type(warn) == "function" then
                local oldWarn = warn
                hookfunction(warn, nc(function(...)
                    for _, a in ipairs({...}) do
                        if type(a) == "string" then
                            local l = a:lower()
                            for _, kw in ipairs(_WARN_KW) do
                                if l:find(kw) then return end
                            end
                        end
                    end
                    return oldWarn(...)
                end))
            end
            if type(print) == "function" then
                local oldPrint = print
                hookfunction(print, nc(function(...)
                    for _, a in ipairs({...}) do
                        if type(a) == "string" then
                            local l = a:lower()
                            for _, kw in ipairs(_WARN_KW) do
                                if l:find(kw) then return end
                            end
                        end
                    end
                    return oldPrint(...)
                end))
            end
        end)
    end
    pcall(function()
        LogService.MessageOut:Connect(function(msg)
            if type(msg) ~= "string" then return end
            local l = msg:lower()
            for _, w in ipairs(_SUS) do
                if l:find(w) then LogService:ClearOutput(); return end
            end
        end)
    end)
end
silentLogFilter()

