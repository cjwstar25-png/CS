local function deserializeKeybinds(tbl)
    if type(tbl) ~= "table" then return end
    for k, v in pairs(tbl) do
        local ok, kc = pcall(function() return Enum.KeyCode[v] end)
        if ok and kc then keybinds[k] = kc end
    end
