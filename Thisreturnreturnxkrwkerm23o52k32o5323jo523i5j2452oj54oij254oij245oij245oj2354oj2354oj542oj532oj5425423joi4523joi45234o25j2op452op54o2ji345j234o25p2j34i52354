local espCache = {}
local function setupESP(p)
    if p == LocalPlayer then return end
    local function apply(char)
        if not char then return end
        if espCache[p] then
            pcall(function()
                if espCache[p].Highlight then espCache[p].Highlight:Destroy() end
                if espCache[p].Billboard then espCache[p].Billboard:Destroy() end
            end)
        end
        local hl = Instance.new("Highlight")
        hl.Name = "CubicESP"; hl.Adornee = char
        hl.FillColor = settingsConfig.ESPColor
        hl.OutlineColor = Color3.fromRGB(255,255,255)
        hl.FillTransparency = 0.4
        hl.Enabled = states.ESP and isValidTarget(p)
        hl.Parent = char
        local head = char:FindFirstChild("Head")
        if not head then return end
        local bg = Instance.new("BillboardGui")
        bg.Name = "CubicESPInfo"; bg.Size = UDim2.new(0, 150, 0, 40)
        bg.StudsOffset = Vector3.new(0, 3, 0); bg.AlwaysOnTop = true
        bg.Enabled = states.ESP and isValidTarget(p)
        bg.Parent = head
        local nl = Instance.new("TextLabel")
        nl.Size = UDim2.new(1, 0, 0, 20); nl.BackgroundTransparency = 1
        nl.Font = Enum.Font.GothamBold; nl.Text = p.Name
        nl.TextColor3 = Color3.fromRGB(255,255,255); nl.TextSize = 12
        nl.TextStrokeTransparency = 0.5; nl.Parent = bg
        local il = Instance.new("TextLabel")
        il.Size = UDim2.new(1, 0, 0, 20); il.Position = UDim2.new(0,0,0,18)
        il.BackgroundTransparency = 1; il.Font = Enum.Font.Gotham
        il.Text = "HP: 100"; il.TextColor3 = Color3.fromRGB(200,200,200)
        il.TextSize = 10; il.TextStrokeTransparency = 0.5; il.Parent = bg
        espCache[p] = { Highlight = hl, Billboard = bg, InfoLabel = il }
    end
    p.CharacterAdded:Connect(apply)
    if p.Character then apply(p.Character) end
end
local function removeESP(p)
    if espCache[p] then
        pcall(function()
            if espCache[p].Highlight then espCache[p].Highlight:Destroy() end
            if espCache[p].Billboard then espCache[p].Billboard:Destroy() end
        end)
        espCache[p] = nil
    end
end
