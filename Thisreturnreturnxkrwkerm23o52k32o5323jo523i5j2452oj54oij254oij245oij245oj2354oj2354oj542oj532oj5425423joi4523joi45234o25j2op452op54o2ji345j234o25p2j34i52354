local dragState = { active = false, startPos = nil, startRootPos = nil, moved = false, MOVE_THRESHOLD = 3 }
local function endRootDrag()
    dragState.active = false; dragState.startPos = nil
    dragState.startRootPos = nil; dragState.moved = false
end
local function beginRootDrag(input)
    dragState.active = true
    dragState.startPos = input.Position
    dragState.startRootPos = Root.Position
    dragState.moved = false
    local connEnd, connChanged
    connChanged = input.Changed:Connect(function()
        if input.UserInputState == Enum.UserInputState.End
        or input.UserInputState == Enum.UserInputState.Cancel then
            endRootDrag()
            if connChanged then connChanged:Disconnect() end
            if connEnd then connEnd:Disconnect() end
        end
    end)
    connEnd = UserInputService.InputEnded:Connect(function(i)
        if i == input then
            endRootDrag()
            if connChanged then connChanged:Disconnect() end
            if connEnd then connEnd:Disconnect() end
        end
    end)
end
UserInputService.InputChanged:Connect(function(input)
    if not dragState.active then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
       or input.UserInputType == Enum.UserInputType.Touch then
        if not dragState.startPos then return end
        local delta = input.Position - dragState.startPos
        if not dragState.moved then
            if math.abs(delta.X) < dragState.MOVE_THRESHOLD
               and math.abs(delta.Y) < dragState.MOVE_THRESHOLD then return end
            dragState.moved = true
        end
        local maxX = VIEW.X * 0.5 - 60 * uiScale
        local maxY = VIEW.Y * 0.5 - 60 * uiScale
        Root.Position = UDim2.new(0.5,
            math.clamp(dragState.startRootPos.X.Offset + delta.X, -maxX, maxX),
            0.5,
            math.clamp(dragState.startRootPos.Y.Offset + delta.Y, -maxY, maxY))
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
       or input.UserInputType == Enum.UserInputType.Touch then
        endRootDrag()
    end
end)

