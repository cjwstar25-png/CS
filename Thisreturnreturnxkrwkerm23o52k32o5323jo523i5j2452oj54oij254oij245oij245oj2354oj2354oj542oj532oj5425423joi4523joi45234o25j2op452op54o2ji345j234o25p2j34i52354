local badFlyY = nil
RunService.Heartbeat:Connect(function()
    pcall(function()
        if not states.BadFly then badFlyY = nil; return end
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")
        if not root or not hum then return end
        hum.PlatformStand = true
        if badFlyY == nil then badFlyY = root.Position.Y end
        local cam = getCamera()
        local camCF = cam.CFrame
        local forward = camCF.LookVector * Vector3.new(1,0,1)
        local right = camCF.RightVector * Vector3.new(1,0,1)
        if forward.Magnitude > 0 then forward = forward.Unit end
        if right.Magnitude > 0 then right = right.Unit end
        local move = Vector3.new()
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + forward end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - forward end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - right end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + right end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then badFlyY = badFlyY + 1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then badFlyY = badFlyY - 1 end
        local speed = settingsConfig.BadFlySpeed or 16
        if move.Magnitude > 0 then move = move.Unit * speed end
        root.AssemblyLinearVelocity = Vector3.new(move.X, 0, move.Z)
        root.CFrame = CFrame.new(root.Position.X, badFlyY, root.Position.Z)
    end)
end)

local scanHistory = {}
local scanFlagged = {}

local function scanGetEntry(p)
    if not scanHistory[p] then
        scanHistory[p] = { lastPos = nil, lastPosT = 0, velSamples = {}, score = 0, reasons = {} }
    end
    return scanHistory[p]
end

local function scanPushReason(entry, reason, weight)
    for _, r in ipairs(entry.reasons) do if r == reason then return end end
    table.insert(entry.reasons, reason)
    entry.score = entry.score + weight
end

local function scanUpdatePlayer(p)
    if p == LocalPlayer then return end
    local char = p.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end

    local entry = scanGetEntry(p)
    local now = tick()
    local pos = root.Position

    if entry.lastPos and entry.lastPosT > 0 then
        local delta = now - entry.lastPosT
        if delta > 0.001 then
            local dist = (pos - entry.lastPos).Magnitude
            local speed = dist / delta
            table.insert(entry.velSamples, speed)
            if #entry.velSamples > 12 then table.remove(entry.velSamples, 1) end
            local avg = 0
            for _, s in ipairs(entry.velSamples) do avg = avg + s end
            avg = avg / #entry.velSamples
            local speedThresh = settingsConfig.ScanSpeedThreshold or 60
            if avg > speedThresh and #entry.velSamples >= 6 then scanPushReason(entry, "speed", 25) end
            local tpThresh = settingsConfig.ScanTeleportThreshold or 80
            if dist > tpThresh and delta < 0.5 then scanPushReason(entry, "teleport", 30) end
        end
    end
    entry.lastPos = pos
    entry.lastPosT = now
end

local function scanRenderResult(p, entry)
    local parts = {}
    for _, r in ipairs(entry.reasons) do table.insert(parts, r) end
    if #parts == 0 then parts = {"suspicious"} end
    return p.Name .. " [" .. table.concat(parts, ",") .. "]"
end

_G.__cubicRunScan = function()
    local flagged = 0
    for p, entry in pairs(scanHistory) do
        if p.Parent and entry.score >= 20 then
            flagged = flagged + 1
            local msg = scanRenderResult(p, entry)
            showToast("FLAG: " .. msg, true, P.warn)
            if states.ScanLogToChat then pcall(function() sendChatMessage("[scan] " .. msg) end) end
            scanFlagged[p] = {score = entry.score, reasons = entry.reasons, lastSeen = tick()}
        end
    end
    if flagged == 0 then showToast("Scan: no flags", nil)
    else showToast("Scan: " .. flagged .. " flagged", true, P.warn) end
end

_G.__cubicClearScan = function()
    scanFlagged = {}
    for _, entry in pairs(scanHistory) do
        entry.score = 0; entry.reasons = {}; entry.velSamples = {}
    end
end

local scanTimer, scanReportTimer = 0, 0
RunService.Heartbeat:Connect(function(dt)
    if not states.CheatScan then return end
    scanTimer = scanTimer + dt
    if scanTimer >= 0.1 then
        scanTimer = 0
        for _, p in ipairs(Players:GetPlayers()) do pcall(scanUpdatePlayer, p) end
    end
    scanReportTimer = scanReportTimer + dt
    if scanReportTimer >= 5 then
        scanReportTimer = 0
        for p, entry in pairs(scanHistory) do
            if p.Parent and entry.score >= 20 and entry.reasons[1] then
                local flag = scanFlagged[p]
                if not flag or flag.reasons[1] ~= entry.reasons[1] then
                    local msg = scanRenderResult(p, entry)
                    showToast("SCAN: " .. msg, true, P.warn)
                    if states.ScanLogToChat then pcall(function() sendChatMessage("[scan] " .. msg) end) end
                    scanFlagged[p] = {score = entry.score, reasons = entry.reasons, lastSeen = tick()}
                end
            end
        end
    end
end)

