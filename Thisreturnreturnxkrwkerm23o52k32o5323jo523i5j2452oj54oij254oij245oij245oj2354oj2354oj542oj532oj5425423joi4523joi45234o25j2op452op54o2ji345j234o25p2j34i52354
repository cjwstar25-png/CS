task.spawn(function()
    local cd, active, origPos = 0, false, nil
    while true do
        task.wait(0.08)
        if states.PhaseGod and not active and cd <= 0 then
            local char = LocalPlayer.Character
            local myRoot = char and char:FindFirstChild("HumanoidRootPart")
            if myRoot then
                local myPos = myRoot.Position
                local radius = settingsConfig.PhaseGodRadius or 20
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        local eRoot = p.Character:FindFirstChild("HumanoidRootPart")
                        local eHum = p.Character:FindFirstChild("Humanoid")
                        if eRoot and eHum and eHum.Health > 0 then
                            if (myPos - eRoot.Position).Magnitude < radius then
                                active = true
                                origPos = myRoot.CFrame
                                local cam = getCamera()
                                local savedType, savedCF = cam.CameraType, cam.CFrame
                                cam.CameraType = Enum.CameraType.Scriptable
                                cam.CFrame = savedCF
                                local h = settingsConfig.PhaseGodHeight or 200
                                myRoot.CFrame = CFrame.new(myRoot.Position + Vector3.new(0,h,0))
                                local cache = {}
                                for _, part in ipairs(char:GetDescendants()) do
                                    if part:IsA("BasePart") then
                                        cache[part] = part.CanCollide
                                        part.CanCollide = false
                                    end
                                end
                                pcall(function() myRoot:SetNetworkOwner(nil) end)
                                task.delay(0.22, function()
                                    local c2 = LocalPlayer.Character
                                    local r2 = c2 and c2:FindFirstChild("HumanoidRootPart")
                                    if r2 then r2.CFrame = origPos; r2.AssemblyLinearVelocity = Vector3.zero end
                                    for part, cc in pairs(cache) do
                                        if part and part.Parent then part.CanCollide = cc end
                                    end
                                    local cam2 = getCamera()
                                    cam2.CFrame = savedCF; cam2.CameraType = savedType
                                    active = false; cd = 0.5
                                end)
                                break
                            end
                        end
                    end
                end
            end
        end
        if cd > 0 then cd = cd - 0.08 end
    end
end)

