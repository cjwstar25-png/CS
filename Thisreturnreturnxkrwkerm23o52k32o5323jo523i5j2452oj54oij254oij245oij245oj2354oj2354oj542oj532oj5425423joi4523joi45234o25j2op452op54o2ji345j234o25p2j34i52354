local function doOneClick()
    local cam = getCamera()
    local camCF = cam and cam.CFrame or CFrame.new()
    if VirtualUser then
        local ok = pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:Button1Down(Vector3.new(0,0,0), camCF)
            task.wait(0.015)
            VirtualUser:Button1Up(Vector3.new(0,0,0), camCF)
        end)
        if ok then return end
    end
    if type(mouse1click) == "function" then
        pcall(function() mouse1click(); task.wait(0.015) end)
        return
    end
    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool then if pcall(function() tool:Activate() end) then return end end
    if AttackRemote then pcall(function() AttackRemote:FireServer() end) end
end

local triggerCooldown = 0
RunService.RenderStepped:Connect(function(dt)
    if not states.AdvancedSilentAim then return end
    local char = LocalPlayer.Character
    if not char then return end
    local target = getClosestTarget()
    if not target then return end
    local head = target.Character:FindFirstChild("Head")
    if not head then return end
    local cam = getCamera()
    local sp, onScreen = cam:WorldToScreenPoint(head.Position)
    if not onScreen then return end
    local vps = cam.ViewportSize
    local center = Vector2.new(vps.X/2, vps.Y/2)
    local angle = (sp - center).Magnitude / math.min(vps.X, vps.Y) * (cam.FieldOfView/2) * 2.2
    if angle > settingsConfig.AimFOV then return end
    if not states.Wallbang then
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {char, target.Character}
        local dir = (head.Position - cam.CFrame.Position).Unit * 500
        local result = Workspace:Raycast(cam.CFrame.Position, dir, params)
        if result then return end
    end
    smoothLookAt(head.Position, settingsConfig.AimSmoothness or 0.35, dt)
    registerHit(target)
    if states.TriggerBot then
        triggerCooldown = triggerCooldown - dt
        if triggerCooldown <= 0 then doOneClick(); triggerCooldown = settingsConfig.TriggerDelay end
    end
end)

