local function collectRemotes()
    discoveredRemotes = {}
    local roots = {
        ReplicatedStorage, Workspace, LocalPlayer,
        LocalPlayer:FindFirstChild("PlayerScripts"),
        LocalPlayer:FindFirstChild("PlayerGui"),
        LocalPlayer:FindFirstChild("Backpack"),
        LocalPlayer:FindFirstChild("Character"),
        game:GetService("ReplicatedFirst"),
        game:GetService("StarterGui"),
        game:GetService("StarterPack"),
        game:GetService("StarterPlayer"),
        game:GetService("Chat"),
    }
    for _, root in ipairs(roots) do
        if root then
            pcall(function()
                for _, v in ipairs(root:GetDescendants()) do
                    if v:IsA("RemoteEvent") then table.insert(discoveredRemotes, v) end
                end
            end)
        end
    end
    pcall(function()
        for _, v in ipairs(game:GetDescendants()) do
            if v:IsA("RemoteEvent") then
                local already = false
                for _, x in ipairs(discoveredRemotes) do
                    if x == v then already = true; break end
                end
                if not already then table.insert(discoveredRemotes, v) end
            end
        end
    end)
end

local function analyzeRemotes()
    collectRemotes()
    local bestAtk, bestAtkScore = nil, 0
    local bestDmg, bestDmgScore = nil, 0
    local bestHit, bestHitScore = nil, 0
    for _, ev in ipairs(discoveredRemotes) do
        local n = ev.Name:lower()
        local fn = ev:GetFullName():lower()
        if not isBlacklisted(n) and not isBlacklisted(fn) then
            local atk = scoreName(n, _ATK_WORDS)
            local dmg = scoreName(n, _DMG_WORDS)
            if atk > bestAtkScore then bestAtkScore = atk; bestAtk = ev end
            if dmg > bestDmgScore and ev ~= bestAtk then bestDmgScore = dmg; bestDmg = ev end
            if (atk + dmg) > bestHitScore and ev ~= bestAtk and ev ~= bestDmg then
                bestHitScore = atk + dmg; bestHit = ev
            end
        end
    end
    if bestAtkScore >= 10 then AttackRemote = bestAtk end
    if bestDmgScore >= 10 then DamageRemote = bestDmg end
    if bestHitScore >= 10 then HitRemote = bestHit end
end
analyzeRemotes()

