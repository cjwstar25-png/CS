local function applyData(data)
    if type(data) ~= "table" then return false end
    if data.States then
        for k, v in pairs(data.States) do
            if states[k] ~= nil and type(v) == type(states[k]) then states[k] = v end
        end
    end
    if data.Settings then
        for k, v in pairs(data.Settings) do
            if settingsConfig[k] ~= nil and type(v) == type(settingsConfig[k]) then settingsConfig[k] = v end
        end
    end
    if data.Skin then currentSkin = data.Skin end
    if data.Keybinds then keybinds = {}; deserializeKeybinds(data.Keybinds) end
    return true
end

local function loadState()
    local raw
    pcall(function() if isfile(SAVE_PATH) then raw = readfile(SAVE_PATH) end end)
    if not raw then return end
    pcall(function()
        local data = HttpService:JSONDecode(raw)
        applyData(data)
    end)
end

