local function setupLog(player)
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return end
    local last = hum.Health
    hum.HealthChanged:Connect(function(new)
        if new < last and new > 0 then
            local t = lastHitTime[player]
            local iHit = t and (tick() - t) < KILL_WINDOW
            if iHit and states.Log and states.LogHits then
                showToast(string.format("Hit %s -%d", player.Name, math.floor(last - new)), true)
            end
            if states.Log and states.LogDamage and not iHit then
                showToast(string.format("%s -%d HP", player.Name, math.floor(last - new)), nil)
            end
        elseif new <= 0 and last > 0 then
            local t = lastHitTime[player]
            if t and (tick() - t) < KILL_WINDOW then
                if states.Log and states.LogKills then showToast("Killed " .. player.Name, true) end
                if states.ChatSpam then
                    local msg = pickChatSpamMessage()
                    if msg then trySendSpam(msg .. " " .. player.Name .. " //") end
                end
            end
        end
        last = new
    end)
end
local function attachLog(p)
    if p == LocalPlayer then return end
    p.CharacterAdded:Connect(function() task.wait(0.5); setupLog(p) end)
    if p.Character then setupLog(p) end
end
