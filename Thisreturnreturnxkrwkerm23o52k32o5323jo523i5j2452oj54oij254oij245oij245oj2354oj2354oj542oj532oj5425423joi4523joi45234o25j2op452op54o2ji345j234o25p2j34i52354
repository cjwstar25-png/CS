local function applySkin(skinName)
    local char = LocalPlayer.Character
    if not char then return end
    if skinName == "Rainbow" then
        task.spawn(function()
            local hue = 0
            while states.SkinChanger and currentSkin == "Rainbow" do
                hue = (hue + 0.01) % 1
                local color = Color3.fromHSV(hue, 1, 1)
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        part.BrickColor = BrickColor.new(color)
                    end
                end
                task.wait(0.05)
            end
        end)
        return
    end
    local colorMap = { Dark = Color3.fromRGB(20,20,25), Neon = Color3.fromRGB(0,255,200) }
    local color = colorMap[skinName]
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            if color then part.BrickColor = BrickColor.new(color) end
        end
    end
end

