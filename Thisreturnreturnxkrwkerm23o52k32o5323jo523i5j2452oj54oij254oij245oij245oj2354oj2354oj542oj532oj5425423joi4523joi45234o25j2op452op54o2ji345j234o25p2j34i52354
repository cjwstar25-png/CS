                if input.KeyCode == Enum.KeyCode.Escape then
                    keybinds[stateKey] = nil
                else
                    keybinds[stateKey] = input.KeyCode
                end
                if conn then conn:Disconnect() end
                saveState()
            end
        end)
    end)
    return btn
end

local function makeSlider(parent, label, min, max, valueKey, callback)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, 0, 0, (BTN_H + 10) * uiScale)
    row.BackgroundColor3 = P.bg_btn
    row.BorderSizePixel = 0
    corner(row, 5)
    stroke(row, P.border_soft, 1, 0.5)

    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(0.7, 0, 0, 14 * uiScale)
    lbl.Position = UDim2.new(0, 10 * uiScale, 0, 4 * uiScale)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.Gotham
    lbl.Text = label
    lbl.TextColor3 = P.text_dim
    lbl.TextSize = 10 * uiScale
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextTruncate = Enum.TextTruncate.AtEnd

    local val = Instance.new("TextLabel", row)
    val.Size = UDim2.new(0.3, 0, 0, 14 * uiScale)
    val.Position = UDim2.new(0.7, -10 * uiScale, 0, 4 * uiScale)
    val.BackgroundTransparency = 1
    val.Font = Enum.Font.GothamBold
    local init = settingsConfig[valueKey] or min
    val.Text = tostring(init)
    val.TextColor3 = P.text
    val.TextSize = 10 * uiScale
    val.TextXAlignment = Enum.TextXAlignment.Right

    local track = Instance.new("Frame", row)
    track.Size = UDim2.new(1, -20 * uiScale, 0, 3 * uiScale)
    track.Position = UDim2.new(0, 10 * uiScale, 1, -10 * uiScale)
    track.BackgroundColor3 = P.bg_input
    track.BorderSizePixel = 0
    corner(track, 2)

    local range = math.max(0.0001, max - min)
    local initRatio = math.clamp((init - min) / range, 0, 1)
    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new(initRatio, 0, 1, 0)
    fill.BackgroundColor3 = P.text_dim
    fill.BorderSizePixel = 0
    corner(fill, 2)

    local handle = Instance.new("Frame", track)
    handle.Size = UDim2.new(0, 10 * uiScale, 0, 10 * uiScale)
    handle.AnchorPoint = Vector2.new(0.5, 0.5)
    handle.Position = UDim2.new(initRatio, 0, 0.5, 0)
    handle.BackgroundColor3 = P.text
    handle.BorderSizePixel = 0
    corner(handle, 5)

    local function applyFromX(absX)
        local ax = track.AbsolutePosition.X
        local aw = track.AbsoluteSize.X
        local ratio = math.clamp((absX - ax) / aw, 0, 1)
        local v = min + ratio * range
        if (max - min) >= 10 then
            v = math.floor(v + 0.5)
        else
            v = math.floor(v * 100 + 0.5) / 100
        end
        settingsConfig[valueKey] = v
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        handle.Position = UDim2.new(ratio, 0, 0.5, 0)
        val.Text = tostring(v)
        if callback then callback(v) end
    end

    local dragging = false
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; applyFromX(input.Position.X)
        end
    end)
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
           or input.UserInputType == Enum.UserInputType.Touch then
            applyFromX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false; saveState()
        end
    end)
    return row
end

